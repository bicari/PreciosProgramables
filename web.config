<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- ── 1. Quitar WebDAV ────────────────────────────────────────────────
             WebDAVModule intercepta PATCH/PUT/DELETE antes de llegar a Django
             y devuelve 405. Esto es la causa raíz del problema con la API REST.
        ──────────────────────────────────────────────────────────────────────── -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <handlers>
            <!-- Remover el handler de WebDAV primero -->
            <remove name="WebDAV" />

            <!-- Archivos estáticos servidos directamente por IIS (no pasan por Django) -->
            <add name="StaticFileHandler"       path="*.css"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerJs"      path="*.js"    verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerImg"     path="*.png"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerJpg"     path="*.jpg"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerGif"     path="*.gif"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerSvg"     path="*.svg"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerFonts"   path="*.woff"  verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerFonts2"  path="*.woff2" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
            <add name="StaticFileHandlerFonts3"  path="*.ttf"   verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />

            <!-- Todas las demás peticiones (incluida /api/) van a Django vía wfastcgi -->
            <add name="DjangoHandler" path="*" verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="A:\PreciosProgramables-master\venv\Scripts\python.exe|A:\PreciosProgramables-master\venv\Lib\site-packages\wfastcgi.py"
                 resourceType="Unspecified" requireAccess="Script" />
        </handlers>

        <!-- ── 2. Seguridad / filtrado de peticiones ──────────────────────────
             Permitir explícitamente todos los verbos REST para que ningún filtro
             adicional de IIS los bloquee (defensa en profundidad).
             maxAllowedContentLength: 50 MB para soportar subida de foto_incidencia.
        ──────────────────────────────────────────────────────────────────────── -->
        <security>
            <requestFiltering allowDoubleEscaping="true">
                <verbs allowUnlisted="true">
                    <add verb="GET"     allowed="true" />
                    <add verb="POST"    allowed="true" />
                    <add verb="PATCH"   allowed="true" />
                    <add verb="PUT"     allowed="true" />
                    <add verb="DELETE"  allowed="true" />
                    <add verb="OPTIONS" allowed="true" />
                    <add verb="HEAD"    allowed="true" />
                </verbs>
                <!-- 50 MB: evita 404.13 "Request entity too large" en subida de fotos -->
                <requestLimits maxAllowedContentLength="52428800" />
            </requestFiltering>
        </security>
        <httpErrors existingResponse="PassThrough" />

    </system.webServer>

    <appSettings>
        <!-- Log de wfastcgi (errores de arranque de la app, NO de Django) -->
        <add key="WSGI_LOG"     value="A:\PreciosProgramables-master\logs\wfastcgi.log" />
        <add key="WSGI_HANDLER" value="Programarprecios.wsgi.application" />
        <add key="PYTHONPATH"   value="A:\PreciosProgramables-master" />
    </appSettings>
</configuration>
